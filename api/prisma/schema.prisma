generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  Admin
  User
}

enum StatusKamar {
  Tersedia
  Tersewa
  TidakTersedia
}

enum StatusPembayaran {
  Lunas
  Pending
  Expired
  Dibatalkan
}

enum MetodePembayaran {
  Transfer
  Tunai
}

// User / Admin
model tb_user {
  id                Int                     @id @default(autoincrement())
  username          String                  @db.VarChar(50)
  email             String                  @unique
  role              Role                    @default(User)
  password          String
  notelp            String
  resetToken        String?                 @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  orders            tb_order[]
  riwayatPembayaran tb_riwayat_pembayaran[]
  accessTokens      tb_accessToken[]
  refreshTokens     tb_refreshToken[]
}

// Access Token
model tb_accessToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text // Text untuk token panjang
  tokenId   String   @unique // UUID untuk identifier
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user tb_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@index([expiresAt])
}

// Refresh Token
model tb_refreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  tokenId   String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user tb_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@index([expiresAt])
}

// Kamar
model tb_kamar {
  id                Int                     @id @default(autoincrement())
  nomorKamar        String                  @unique
  hargaSewa         Int
  statusKamar       StatusKamar             @default(Tersedia)
  deskripsi         String
  orders            tb_order[]
  fasilitas         tb_kamar_fasilitas[]
  perabotan         tb_kamar_perabotan[]
  riwayatPembayaran tb_riwayat_pembayaran[]
}

// Fasilitas
model tb_fasilitas {
  id            Int                  @id @default(autoincrement())
  namaFasilitas String               @db.VarChar(30)
  kodeFasilitas String               @unique
  deskripsi     String
  kamar         tb_kamar_fasilitas[]
}

// Perabotan
model tb_perabotan {
  id            Int                  @id @default(autoincrement())
  namaPerabotan String               @db.VarChar(30)
  kodePerabotan String               @unique
  deskripsi     String
  kamar         tb_kamar_perabotan[]
}

// Junction table untuk many-to-many Kamar-Fasilitas
model tb_kamar_fasilitas {
  id          Int          @id @default(autoincrement())
  kamarId     Int
  fasilitasId Int
  kamar       tb_kamar     @relation(fields: [kamarId], references: [id], onDelete: Cascade)
  fasilitas   tb_fasilitas @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)

  @@unique([kamarId, fasilitasId])
}

// Junction table untuk many-to-many Kamar-Perabotan
model tb_kamar_perabotan {
  id          Int          @id @default(autoincrement())
  kamarId     Int
  perabotanId Int
  jumlah      Int          @default(1)
  kamar       tb_kamar     @relation(fields: [kamarId], references: [id], onDelete: Cascade)
  perabotan   tb_perabotan @relation(fields: [perabotanId], references: [id], onDelete: Cascade)

  @@unique([kamarId, perabotanId])
}

// Order/Pesanan
model tb_order {
  id               Int              @id @default(autoincrement())
  kodeOrder        String           @unique
  userId           Int
  kamarId          Int
  tanggalPesanan   DateTime         @default(now())
  tanggalCheckin   DateTime
  tanggalCheckout  DateTime
  statusPembayaran StatusPembayaran @default(Pending)
  totalHarga       Int
  metodePembayaran MetodePembayaran
  buktiPembayaran  String? // URL/path file bukti pembayaran
  catatanUser      String? // Catatan dari user saat memesan
  catatanAdmin     String? // Catatan dari admin untuk order ini
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user              tb_user                 @relation(fields: [userId], references: [id])
  kamar             tb_kamar                @relation(fields: [kamarId], references: [id])
  riwayatPembayaran tb_riwayat_pembayaran[]

  @@index([userId])
  @@index([kamarId])
  @@index([statusPembayaran])
}

// Riwayat Pembayaran - untuk tracking perubahan status pembayaran
model tb_riwayat_pembayaran {
  id                   Int               @id @default(autoincrement())
  kodeRiwayat          String            @unique
  orderId              Int
  userId               Int
  kamarId              Int
  statusPembayaranLama StatusPembayaran? // Status sebelumnya (null jika baru dibuat)
  statusPembayaranBaru StatusPembayaran // Status yang baru
  totalHarga           Int
  metodePembayaran     MetodePembayaran
  buktiPembayaran      String? // Snapshot bukti pembayaran saat itu
  keterangan           String? // Keterangan perubahan (misal: "Pembayaran dikonfirmasi oleh admin")
  diubahOleh           String? // Username yang mengubah (admin/sistem)
  createdAt            DateTime          @default(now())

  order tb_order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  tb_user  @relation(fields: [userId], references: [id])
  kamar tb_kamar @relation(fields: [kamarId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([kamarId])
  @@index([createdAt])
}
