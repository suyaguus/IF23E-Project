generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  Admin
  User
}

enum StatusKamar {
  Tersedia
  Tersewa
  TidakTersedia
}

enum StatusPembayaran {
  Lunas
  Pending
  Expired
  Dibatalkan
}

enum MetodePembayaran {
  Transfer
  Tunai
}

model tb_user {
  id                Int                     @id @default(autoincrement())
  username          String                  @db.VarChar(50)
  email             String                  @unique
  role              Role                    @default(User)
  password          String
  notelp            String
  imageUrl          String?
  imageId           String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  
  orders            tb_order[]
  riwayatPembayaran tb_riwayat_pembayaran[]
}

// Kamar
model tb_kamar {
  id                Int                     @id @default(autoincrement())
  nomorKamar        String                  @unique
  hargaSewa         Int
  statusKamar       StatusKamar             @default(Tersedia)
  deskripsi         String

  images            tb_kamar_image[]
  orders            tb_order[]
  fasilitas         tb_kamar_fasilitas[]
  perabotan         tb_kamar_perabotan[]
  riwayatPembayaran tb_riwayat_pembayaran[]
}
// Kamar Image
model tb_kamar_image {
  id        Int      @id @default(autoincrement())
  kamarId   Int
  imageUrl  String
  imageId   String
  createdAt DateTime @default(now())

  kamar tb_kamar @relation(fields: [kamarId], references: [id], onDelete: Cascade)

  @@index([kamarId])
}

// Fasilitas
model tb_fasilitas {
  id            Int                  @id @default(autoincrement())
  namaFasilitas String               @db.VarChar(30)
  kodeFasilitas String               @unique
  deskripsi     String
  imageUrl      String?
  imageId       String?

  kamar         tb_kamar_fasilitas[]
}

// Perabotan
model tb_perabotan {
  id            Int                  @id @default(autoincrement())
  namaPerabotan String               @db.VarChar(30)
  kodePerabotan String               @unique
  deskripsi     String
  imageUrl      String?
  imageId       String?

  kamar         tb_kamar_perabotan[]
}

// Junction table untuk many-to-many Kamar-Fasilitas
model tb_kamar_fasilitas {
  id          Int          @id @default(autoincrement())
  kamarId     Int
  fasilitasId Int
  kamar       tb_kamar     @relation(fields: [kamarId], references: [id], onDelete: Cascade)
  fasilitas   tb_fasilitas @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)

  @@unique([kamarId, fasilitasId])
}

// Junction table untuk many-to-many Kamar-Perabotan
model tb_kamar_perabotan {
  id          Int          @id @default(autoincrement())
  kamarId     Int
  perabotanId Int
  jumlah      Int          @default(1)
  kamar       tb_kamar     @relation(fields: [kamarId], references: [id], onDelete: Cascade)
  perabotan   tb_perabotan @relation(fields: [perabotanId], references: [id], onDelete: Cascade)

  @@unique([kamarId, perabotanId])
}

// Order/Pesanan
model tb_order {
  id               Int              @id @default(autoincrement())
  kodeOrder        String           @unique
  userId           Int
  kamarId          Int
  tanggalPesanan   DateTime         @default(now())
  tanggalCheckin   DateTime
  tanggalCheckout  DateTime
  statusPembayaran StatusPembayaran @default(Pending)
  totalHarga       Int
  metodePembayaran MetodePembayaran
  buktiPembayaran  String?
  catatanUser      String?
  catatanAdmin     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user              tb_user                 @relation(fields: [userId], references: [id])
  kamar             tb_kamar                @relation(fields: [kamarId], references: [id])
  riwayatPembayaran tb_riwayat_pembayaran[]

  @@index([userId])
  @@index([kamarId])
  @@index([statusPembayaran])
}

// Riwayat Pembayaran
model tb_riwayat_pembayaran {
  id                   Int               @id @default(autoincrement())
  kodeRiwayat          String            @unique
  orderId              Int
  userId               Int
  kamarId              Int
  statusPembayaranLama StatusPembayaran?
  statusPembayaranBaru StatusPembayaran
  totalHarga           Int
  metodePembayaran     MetodePembayaran
  buktiPembayaran      String?
  keterangan           String?
  diubahOleh           String?
  createdAt            DateTime          @default(now())

  order tb_order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  tb_user  @relation(fields: [userId], references: [id])
  kamar tb_kamar @relation(fields: [kamarId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([kamarId])
  @@index([createdAt])
}

// buat table otp
model tb_otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
